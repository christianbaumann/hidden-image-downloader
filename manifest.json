{
  "manifest_version": 3,
  "name": "Hidden Image Downloader",
  "version": "0.1.0",
  "description": "Download images that websites hide behind a transparent overlay.",
  "author": "Christian Baumann <mail@christianbaumann.dev> (www.christianbaumann.dev)",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Download hidden image"
  },
  "permissions": [
    "scripting",
    "downloads",
    "offscreen",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://www.joyclub.de/*",
    "https://www.joyclub.com/*",
    "https://image-user.feig-partner.de/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.joyclub.de/*", "https://www.joyclub.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
